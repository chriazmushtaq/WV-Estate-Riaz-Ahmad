}

body.wv-admin-theme .wv-admin-topbar .dropdown-menu .theme-dot-light,
body.wv-admin-theme .wv-admin-topbar .dropdown-menu .theme-dot-dark,
body.wv-admin-theme .wv-admin-topbar .dropdown-menu .theme-dot-gold,
body.wv-admin-theme .wv-admin-topbar .dropdown-menu .theme-dot-green {
    color: transparent !important;
}

body.wv-admin-theme,
body.wv-admin-theme #sidebar-main.sidebar,
body.wv-admin-theme .content-wrapper,
body.wv-admin-theme .panel,
body.wv-admin-theme .page-title,
body.wv-admin-theme .btn,
body.wv-admin-theme .form-control {
    transition: background-color .2s ease, border-color .2s ease, color .2s ease, box-shadow .2s ease;
}

/* Base resets to avoid table-cell margin collapse */
.page-container {
    display: block !important;
    position: relative !important;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
}

/* Unified Desktop Layout (PC >= 992px) */
@media (min-width: 992px) {
    .page-content {
        display: flex !important;
        flex-direction: row !important;
        align-items: stretch !important;
        width: 100% !important;
        min-height: calc(100vh - 68px) !important;
        position: relative !important;
        margin: 0 !important;
        padding: 0 !important;
        box-sizing: border-box !important;
    }

    #sidebar-main.sidebar,
    body.wv-admin-theme #sidebar-main.sidebar {
        display: block !important;
        flex: 0 0 240px !important;
        width: 240px !important;
        min-width: 240px !important;
        max-width: 240px !important;
        position: sticky !important;
        top: 0 !important;
        height: 100vh !important;
        max-height: 100vh !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
        z-index: 1000 !important;
        background: linear-gradient(180deg, #07152a 0%, #0d223f 100%) !important;
        box-shadow: 4px 0 20px rgba(0, 0, 0, 0.15) !important;
        border-right: 1px solid rgba(255, 255, 255, 0.08) !important;
        transform: none !important;
        visibility: visible !important;
        pointer-events: auto !important;
        margin: 0 !important;
        left: auto !important;
        bottom: auto !important;
        box-sizing: border-box !important;
    }

    body.wv-admin-theme.wv-admin-sidebar-collapsed #sidebar-main.sidebar,
    body.wv-admin-theme #sidebar-main.sidebar.sidebar-collapsed,
    #sidebar-main.sidebar.sidebar-collapsed {
        flex: 0 0 70px !important;
        width: 70px !important;
        min-width: 70px !important;
        max-width: 70px !important;
    }

    .content-wrapper,
    body.wv-admin-theme .content-wrapper {
        display: block !important;
        flex: 1 1 auto !important;
        min-width: 0 !important;
        width: calc(100% - 240px) !important;
        max-width: calc(100% - 240px) !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        padding: 0 !important;
        box-sizing: border-box !important;
    }

    body.wv-admin-theme.wv-admin-sidebar-collapsed #sidebar-main.sidebar + .content-wrapper,
    body.wv-admin-theme #sidebar-main.sidebar.sidebar-collapsed + .content-wrapper,
    #sidebar-main.sidebar.sidebar-collapsed + .content-wrapper {
        width: calc(100% - 70px) !important;
        max-width: calc(100% - 70px) !important;
        margin-left: 0 !important;
    }
}

/* Mobile Resets (<= 991px) */
@media (max-width: 991px) {
    .page-content {
        display: block !important;
        width: 100% !important;
    }

    .content-wrapper,
    body.wv-admin-theme .content-wrapper {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        padding: 0 !important;
        box-sizing: border-box !important;
    }
}

/* =========================================================================
   White Villas Topbar Notification Bell & Luxury Dropdown
   ========================================================================= */
.wv-admin-notif-dropdown {
    position: relative;
}

.notif-bell-btn {
    position: relative !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
}

.notif-unread-badge {
    position: absolute !important;
    top: 4px !important;
    right: 4px !important;
    font-size: 10px !important;
    font-weight: 800 !important;
    padding: 2px 5px !important;
    border-radius: 999px !important;
    background: linear-gradient(135deg, #ef4444, #dc2626) !important;
    color: #ffffff !important;
    border: 2px solid #ffffff !important;
    line-height: 1 !important;
    box-shadow: 0 2px 6px rgba(239, 68, 68, 0.45) !important;
    transform: translate(25%, -25%);
}

@keyframes notifBellSwing {
    0%, 100% { transform: rotate(0deg); }
    20% { transform: rotate(14deg); }
    40% { transform: rotate(-14deg); }
    60% { transform: rotate(8deg); }
    80% { transform: rotate(-8deg); }
}

.notif-bell-btn.notif-has-unread i,
#notifBellIcon.notif-has-unread {
    animation: notifBellSwing 2.5s ease infinite;
    color: #38bdf8 !important;
}

.wv-admin-notif-menu {
    width: 360px !important;
    min-width: 340px !important;
    max-width: 380px !important;
    border-radius: 14px !important;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.22) !important;
    border: 1px solid #e2e8f0 !important;
    padding: 0 !important;
    margin-top: 8px !important;
    overflow: hidden !important;
    background: #ffffff !important;
    z-index: 100050 !important;
}

.wv-notif-menu-header {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 13px 18px !important;
    background: #f8fafc !important;
    border-bottom: 1px solid #edf2f7 !important;
}

.wv-notif-mark-all {
    font-size: 11.5px !important;
    font-weight: 700 !important;
    color: #3b82f6 !important;
    text-decoration: none !important;
    cursor: pointer !important;
}
.wv-notif-mark-all:hover {
    color: #1d4ed8 !important;
    text-decoration: underline !important;
}

.wv-notif-menu-list {
    max-height: 330px !important;
    overflow-y: auto !important;
    background: #ffffff !important;
}

.wv-notif-item {
    display: flex !important;
    align-items: flex-start !important;
    gap: 12px !important;
    padding: 12px 16px !important;
    border-bottom: 1px solid #f1f5f9 !important;
    text-decoration: none !important;
    color: inherit !important;
    transition: background 0.15s ease !important;
}

.wv-notif-item:hover {
    background: #f8fafc !important;
    text-decoration: none !important;
}

.wv-notif-item.unread {
    background: #f0f7ff !important;
}

.wv-notif-item.unread:hover {
    background: #e2e8f0 !important;
}

.wv-notif-icon {
    width: 34px !important;
    height: 34px !important;
    border-radius: 9px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 14px !important;
    flex-shrink: 0 !important;
    margin-top: 2px !important;
}

.wv-notif-content {
    flex: 1 1 auto !important;
    min-width: 0 !important;
}

.wv-notif-title {
    font-weight: 800 !important;
    font-size: 13px !important;
    color: #0f172a !important;
    line-height: 1.3 !important;
    margin-bottom: 2px !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}

.wv-notif-snippet {
    font-size: 12px !important;
    color: #475569 !important;
    line-height: 1.35 !important;
    display: -webkit-box !important;
    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
}

.wv-notif-time {
    font-size: 10.5px !important;
    color: #94a3b8 !important;
    margin-top: 4px !important;
}

.wv-notif-dot {
    width: 8px !important;
    height: 8px !important;
    border-radius: 50% !important;
    background: #2563eb !important;
    flex-shrink: 0 !important;
    margin-top: 6px !important;
}

.wv-notif-menu-footer {
    padding: 10px 16px !important;
    text-align: center !important;
    background: #f8fafc !important;
    border-top: 1px solid #edf2f7 !important;
}

.wv-notif-menu-footer a {
    font-size: 12px !important;
    font-weight: 700 !important;
    color: #2563eb !important;
    text-decoration: none !important;
}
.wv-notif-menu-footer a:hover {
    text-decoration: underline !important;
}
