.wv-admin-topbar {
    align-items: center;
    background: linear-gradient(135deg, var(--admin-theme-accent, #0f172a), var(--admin-theme-accent-2, #1d4ed8)) !important;
    border-bottom: 1px solid rgba(255,255,255,.14) !important;
    box-shadow: var(--admin-theme-shadow, 0 18px 40px rgba(15,23,42,.08));
    color: #ffffff !important;
    display: flex !important;
    flex-wrap: nowrap;
    gap: 12px;
    justify-content: flex-start;
    min-height: 68px;
    padding: 0 18px 0 0;
    position: relative;
    z-index: 1035;
}

.wv-admin-topbar .navbar-brand.logo {
    background: rgba(255,255,255,.08) !important;
    border-radius: 0 0 18px 0;
    box-shadow: none;
    flex: 0 0 210px;
    height: 68px;
    margin: 0 !important;
    min-width: 210px;
    padding: 0 18px !important;
}

.wv-admin-topbar .navbar-brand.logo span,
.wv-admin-topbar .navbar-toggler i,
.wv-admin-topbar .sidebar-toggle i {
    color: #ffffff !important;
}

.wv-admin-topbar,
.wv-admin-topbar a,
.wv-admin-topbar span,
.wv-admin-topbar button,
.wv-admin-topbar i,
.wv-admin-topbar .wv-admin-breadcrumbs,
.wv-admin-topbar .wv-admin-breadcrumbs a,
.wv-admin-topbar .wv-admin-breadcrumb-sep {
    color: #ffffff !important;
}

.wv-admin-topbar #toggle-sidebar {
    flex: 0 0 38px;
    left: auto !important;
    margin: 0 0 0 18px !important;
    margin-right: 0 !important;
    order: 1;
    position: relative !important;
    right: auto !important;
}

body.wv-admin-theme .wv-admin-topbar .navbar-brand.logo {
    order: 2;
}

.wv-admin-header-center {
    flex: 1 1 auto;
    min-width: 0;
    order: 3;
    padding: 0 18px;
}

.wv-admin-breadcrumbs {
    align-items: center;
    color: var(--admin-theme-text-soft, #5b6b83);
    display: flex;
    flex-wrap: wrap;
    font-size: 12px;
    font-weight: 700;
    gap: 8px;
}

.wv-admin-breadcrumbs a {
    color: var(--admin-theme-primary, #2563eb);
}

.wv-admin-breadcrumb-sep {
    color: var(--admin-theme-text-soft, #5b6b83);
}

.wv-admin-topbar-actions {
    align-items: center;
    display: flex;
    flex-wrap: nowrap;
    gap: 10px;
    justify-content: flex-end;
    margin-left: auto;
    min-width: 0;
}

.wv-admin-quick-search {
    align-items: center;
    background: #ffffff !important;
    border: 1px solid var(--admin-theme-border, #dbe6f3);
    border-radius: 999px;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
    display: flex;
    gap: 8px;
    min-height: 42px;
    padding: 0 14px;
    width: 220px;
}

.wv-admin-quick-search i {
    color: var(--admin-theme-primary, #2563eb) !important;
}

.wv-admin-quick-search input {
    background: #ffffff !important;
    border: 0;
    box-shadow: none;
    color: var(--admin-theme-text, #10213a);
    outline: none;
    width: 100%;
}

.wv-admin-quick-search-btn {
    align-items: center;
    background: transparent !important;
    border: 0;
    border-radius: 999px;
    color: var(--admin-theme-primary, #2563eb);
    display: inline-flex;
    flex: 0 0 28px;
    height: 28px;
    justify-content: center;
    padding: 0;
    width: 28px;
}

.wv-admin-quick-search input,
.wv-admin-quick-search input::placeholder {
    color: #10213a !important;
}

.wv-admin-quick-search-btn i {
    color: var(--admin-theme-primary, #2563eb) !important;
}

.wv-admin-quick-search.page-search-empty,
.wv-admin-quick-search.page-search-miss {
    border-color: #ef4444 !important;
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.10);
}

.wv-admin-icon-btn,
.wv-admin-theme-dropdown > a {
    align-items: center;
    background: transparent !important;
    border: 0 !important;
    border-radius: 0;
    color: #ffffff !important;
    display: inline-flex;
    gap: 8px;
    justify-content: center;
    min-height: 42px;
    min-width: 24px;
    padding: 0 6px;
    box-shadow: none !important;
}

.wv-admin-icon-btn i,
.wv-admin-theme-dropdown > a i,
.wv-admin-theme-dropdown > a span {
    color: #ffffff !important;
}

.wv-admin-theme-dropdown > a:hover,
.wv-admin-theme-dropdown > a:focus,
.wv-admin-icon-btn:hover,
.wv-admin-icon-btn:focus {
    background: rgba(255,255,255,.12) !important;
    color: #ffffff !important;
}

.wv-admin-theme-menu {
    min-width: 320px !important;
    padding: 14px !important;
    border-radius: 12px !important;
    box-shadow: 0 12px 36px rgba(15, 23, 42, 0.18) !important;
    border: 1px solid var(--admin-theme-border, #dbe6f3) !important;
}

.wv-admin-theme-menu .wv-admin-theme-selector {
    padding: 0;
    gap: 8px;
}

.wv-admin-theme-menu-title {
    border-radius: 8px;
    font-weight: 800;
    font-size: 12px;
    color: var(--admin-theme-text, #10213a);
    margin-bottom: 8px;
    padding: 4px 6px;
}

.wv-admin-notice-pill {
    align-items: center;
    background: var(--admin-theme-primary-soft, #dbeafe);
    border: 1px solid var(--admin-theme-border, #dbe6f3);
    border-radius: 999px;
    color: var(--admin-theme-text, #10213a);
    display: inline-flex;
    font-size: 12px;
    font-weight: 700;
    gap: 8px;
    min-height: 42px;
    padding: 0 14px;
    white-space: nowrap;
}

.wv-admin-sidebar-shell {
    padding: 14px 12px 18px;
}

.wv-admin-sidebar-brand {
    align-items: center;
    background: rgba(255, 255, 255, 0.06) !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    border-radius: 14px;
    display: flex;
    gap: 12px;
    margin: 0 0 14px;
    padding: 12px;
}

.wv-admin-sidebar-brand-logo {
    align-items: center;
    background: linear-gradient(135deg, #1e3a8a, #0284c7);
    border-radius: 12px;
    color: #ffffff;
    display: inline-flex;
    height: 38px;
    justify-content: center;
    width: 38px;
}

.wv-admin-sidebar-brand-copy strong {
    color: #ffffff !important;
    display: block;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.2;
}

.wv-admin-sidebar-brand-copy span {
    color: #94a3b8;
    display: block;
    font-size: 11px;
    font-weight: 700;
    margin-top: 3px;
    text-transform: uppercase;
}

.wv-admin-sidebar-brand-copy .wv-admin-sidebar-meta {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.wv-admin-sidebar-brand-copy .wv-admin-sidebar-meta em {
    background: rgba(56, 189, 248, 0.18) !important;
    border: 1px solid rgba(56, 189, 248, 0.35) !important;
    border-radius: 999px;
    color: #38bdf8 !important;
    font-style: normal;
    font-size: 10px;
    font-weight: 800;
    line-height: 1;
    padding: 3px 8px;
}

.wv-admin-sidebar-search-wrap {
    align-items: center;
    background: rgba(255, 255, 255, 0.08) !important;
    border: 1px solid rgba(255, 255, 255, 0.14) !important;
    border-radius: 10px;
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
    padding: 0 12px;
}

.wv-admin-sidebar-search {
    background: transparent;
    border: 0 !important;
    box-shadow: none !important;
    color: #ffffff !important;
    min-height: 38px;
    outline: none;
    width: 100%;
}
.wv-admin-sidebar-search::placeholder {
    color: #94a3b8 !important;
}

.wv-admin-sidebar-search-icon {
    color: #94a3b8 !important;
}

body.wv-admin-theme #sidebar-main .sidebar-content {
    overflow-x: hidden !important;
}

body.wv-admin-theme .wv-admin-topbar #navbarNav {
    align-items: center !important;
