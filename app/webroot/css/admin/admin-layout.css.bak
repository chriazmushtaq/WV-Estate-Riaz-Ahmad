body.wv-admin-theme .wv-admin-topbar .dropdown-menu .dropdown-item-text,
body.wv-admin-theme .wv-admin-topbar .dropdown-menu .wv-admin-theme-chip,
body.wv-admin-theme .wv-admin-topbar .dropdown-menu .wv-admin-theme-chip-label {
