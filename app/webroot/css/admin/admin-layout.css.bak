body.wv-admin-theme.wv-admin-sidebar-collapsed #sidebar-main .navigation > li > a > span,
body.wv-admin-theme #sidebar-main.sidebar.sidebar-collapsed .navigation > li > a > span,
body.wv-admin-theme.wv-admin-sidebar-collapsed #sidebar-main .navigation > li > a.has-ul:after,
body.wv-admin-theme #sidebar-main.sidebar.sidebar-collapsed .navigation > li > a.has-ul:after,
body.wv-admin-theme.wv-admin-sidebar-collapsed #sidebar-main .navigation > li > ul,
body.wv-admin-theme #sidebar-main.sidebar.sidebar-collapsed .navigation > li > ul {
