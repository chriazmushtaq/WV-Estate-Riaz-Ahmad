    }
    #sidebar-main.sidebar .wv-admin-sidebar-brand,
    body.wv-admin-theme #sidebar-main.sidebar .wv-admin-sidebar-brand {
        align-items: center !important;
        background: rgba(255, 255, 255, 0.07) !important;
