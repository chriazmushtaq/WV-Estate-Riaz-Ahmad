/* Mobile Admin Drawer & Sidebar Rendering */
.admin-sidebar-backdrop {
    background: rgba(15, 23, 42, 0.65) !important;
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    bottom: 0;
    display: none;
    height: 100vh;
    height: 100dvh;
    left: 0;
    opacity: 0;
    position: fixed;
    right: 0;
    top: 0;
    transition: opacity .25s ease;
    width: 100vw;
    z-index: 100040 !important;
}
body.admin-mobile-sidebar-open .admin-sidebar-backdrop {
    display: block !important;
    opacity: 1 !important;
    pointer-events: auto !important;
}
body.admin-mobile-sidebar-open {
    overflow: hidden !important;
}
@media (max-width: 991px) {
    #sidebar-main.sidebar,
    body.wv-admin-theme #sidebar-main.sidebar,
    body.wv-admin-theme #sidebar-main.sidebar.sidebar-collapsed,
    body #sidebar-main.sidebar {
        background: linear-gradient(180deg, #07152a 0%, #0d223f 100%) !important;
        border-right: 1px solid rgba(124, 249, 255, 0.18) !important;
        bottom: 0 !important;
        box-shadow: 0 0 50px rgba(0, 0, 0, 0.6) !important;
        display: block !important;
        height: 100vh !important;
        height: 100dvh !important;
        left: 0 !important;
        max-height: 100vh !important;
        max-height: 100dvh !important;
        max-width: 86vw !important;
        min-width: 0 !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
        pointer-events: none !important;
        position: fixed !important;
        top: 0 !important;
        transform: translateX(-105%) !important;
        transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.28s ease !important;
        visibility: hidden !important;
        width: 290px !important;
        z-index: 100050 !important;
        -webkit-overflow-scrolling: touch !important;
    }
    body.admin-mobile-sidebar-open #sidebar-main.sidebar,
    body.wv-admin-theme.admin-mobile-sidebar-open #sidebar-main.sidebar,
    body.wv-admin-theme.admin-mobile-sidebar-open #sidebar-main.sidebar.sidebar-collapsed,
    body.wv-admin-theme #sidebar-main.sidebar.is-mobile-open,
    #sidebar-main.sidebar.is-mobile-open {
        box-shadow: 10px 0 50px rgba(0, 0, 0, 0.7) !important;
        pointer-events: auto !important;
        transform: translateX(0) !important;
        visibility: visible !important;
    }
    #sidebar-main.sidebar .sidebar-content,
    body.wv-admin-theme #sidebar-main.sidebar .sidebar-content {
        height: 100% !important;
        max-height: 100% !important;
        min-height: 100% !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
        overscroll-behavior: contain;
        width: 100% !important;
        -webkit-overflow-scrolling: touch !important;
    }
    #sidebar-main.sidebar .wv-admin-sidebar-shell,
    body.wv-admin-theme #sidebar-main.sidebar .wv-admin-sidebar-shell {
        display: block !important;
        min-height: 100% !important;
        padding: 14px 12px 36px !important;
