<script>
(function(){
    window.toggleAdminMobileSidebar = function(e){
        if(e){
            if(typeof e.preventDefault === 'function') e.preventDefault();
            if(typeof e.stopPropagation === 'function') e.stopPropagation();
            if(typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
        }
        var sidebar = document.getElementById('sidebar-main');
        if(!sidebar) return false;
        var backdrop = document.getElementById('admin-mobile-backdrop');
        if(!backdrop){
            backdrop = document.createElement('div');
            backdrop.id = 'admin-mobile-backdrop';
            backdrop.className = 'admin-sidebar-backdrop';
            backdrop.setAttribute('onclick', 'window.closeAdminMobileSidebar && window.closeAdminMobileSidebar(event); return false;');
            document.body.appendChild(backdrop);
        }
        var isOpen = document.body.classList.contains('admin-mobile-sidebar-open') ||
                     sidebar.classList.contains('is-mobile-open') ||
                     sidebar.style.display === 'block';
        if(isOpen && sidebar.getAttribute('data-mobile-opened') === '1'){
            window.closeAdminMobileSidebar(e);
        } else {
            document.body.classList.add('admin-mobile-sidebar-open');
            sidebar.classList.remove('sidebar-collapsed');
            sidebar.classList.add('is-mobile-open');
            sidebar.setAttribute('aria-hidden', 'false');
            sidebar.setAttribute('data-mobile-opened', '1');
            sidebar.style.setProperty('display', 'block', 'important');
            sidebar.style.setProperty('visibility', 'visible', 'important');
            sidebar.style.setProperty('opacity', '1', 'important');
            sidebar.style.setProperty('transform', 'translateX(0)', 'important');
            sidebar.style.setProperty('position', 'fixed', 'important');
            sidebar.style.setProperty('top', '0', 'important');
            sidebar.style.setProperty('left', '0', 'important');
            sidebar.style.setProperty('bottom', '0', 'important');
            sidebar.style.setProperty('height', '100vh', 'important');
            sidebar.style.setProperty('width', '285px', 'important');
            sidebar.style.setProperty('max-width', '86vw', 'important');
            sidebar.style.setProperty('z-index', '100050', 'important');
            sidebar.style.setProperty('overflow-y', 'auto', 'important');
            sidebar.style.setProperty('-webkit-overflow-scrolling', 'touch', 'important');
            sidebar.style.setProperty('pointer-events', 'auto', 'important');
            sidebar.style.setProperty('box-shadow', '10px 0 50px rgba(0,0,0,0.7)', 'important');
            backdrop.style.setProperty('display', 'block', 'important');
            backdrop.style.setProperty('opacity', '1', 'important');
            backdrop.style.setProperty('visibility', 'visible', 'important');
            backdrop.style.setProperty('position', 'fixed', 'important');
            backdrop.style.setProperty('top', '0', 'important');
            backdrop.style.setProperty('left', '0', 'important');
            backdrop.style.setProperty('width', '100vw', 'important');
            backdrop.style.setProperty('height', '100vh', 'important');
            backdrop.style.setProperty('background', 'rgba(15,23,42,0.65)', 'important');
            backdrop.style.setProperty('z-index', '100040', 'important');
            backdrop.style.setProperty('pointer-events', 'auto', 'important');
            document.body.style.overflow = 'hidden';
        }
        return false;
    };

    window.closeAdminMobileSidebar = function(e){
        if(e){
            if(typeof e.preventDefault === 'function') e.preventDefault();
            if(typeof e.stopPropagation === 'function') e.stopPropagation();
            if(typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
        }
        var sidebar = document.getElementById('sidebar-main');
        var backdrop = document.getElementById('admin-mobile-backdrop');
        document.body.classList.remove('admin-mobile-sidebar-open');
        if(sidebar){
            sidebar.classList.remove('is-mobile-open');
            sidebar.setAttribute('aria-hidden', 'true');
            sidebar.removeAttribute('data-mobile-opened');
            if(window.innerWidth <= 768){
                sidebar.style.setProperty('display', 'none', 'important');
                sidebar.style.setProperty('transform', 'translateX(-105%)', 'important');
                sidebar.style.setProperty('visibility', 'hidden', 'important');
                sidebar.style.setProperty('pointer-events', 'none', 'important');
            } else {
                sidebar.style.removeProperty('display');
                sidebar.style.removeProperty('transform');
                sidebar.style.removeProperty('visibility');
                sidebar.style.removeProperty('position');
                sidebar.style.removeProperty('top');
                sidebar.style.removeProperty('left');
                sidebar.style.removeProperty('bottom');
                sidebar.style.removeProperty('height');
                sidebar.style.removeProperty('width');
                sidebar.style.removeProperty('max-width');
                sidebar.style.removeProperty('z-index');
                sidebar.style.removeProperty('opacity');
                sidebar.style.removeProperty('box-shadow');
                sidebar.style.removeProperty('pointer-events');
                sidebar.style.removeProperty('overflow-y');
            }
        }
        if(backdrop){
            backdrop.style.setProperty('display', 'none', 'important');
            backdrop.style.setProperty('opacity', '0', 'important');
            backdrop.style.setProperty('pointer-events', 'none', 'important');
        }
        document.body.style.overflow = '';
        return false;
    };
})();
</script>

