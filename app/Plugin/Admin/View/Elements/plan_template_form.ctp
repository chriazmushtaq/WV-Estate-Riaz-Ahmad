<script>
(function($){
var rowIndex=<?php echo count((array)$scheduleRows);?>,typeOptions=<?php echo json_encode($scheduleTypeOptions);?>,defaults=<?php echo json_encode($typeDefaults);?>;
function num(v){var n=parseFloat(String(v||'').replace(/,/g,''));return isNaN(n)?0:n}function money(v){return 'Rs '+Math.round(v).toLocaleString('en-US')}
function options(){var h='';$.each(typeOptions,function(k,v){h+='<option value="'+k+'">'+v+'</option>'});return h}
function updateAmountMode($r){var percent=$r.find('.amount-mode').val()==='percentage',$input=$r.find('.amount-value');$input.attr('step',percent?'0.01':'0.01').attr('min','0.01').attr('max',percent?'100':null).attr('placeholder',percent?'e.g. 2':'0.00');$r.find('.amount-unit').text(percent?'%':'Rs')}
function updateType($r,force){var t=$r.find('.payment-type').val(),d=defaults[t]||defaults.custom;if(force||!$r.find('.row-title').val())$r.find('.row-title').val(d.title);$r.find('.row-title').prop('readonly',false).attr('placeholder',t==='custom'?'Enter custom payment title':'Payment title');$r.find('.interval-months').val(d.interval).prop('readonly',t!=='custom');var one=$.inArray(t,['token','booking','confirmation','possession','final'])!==-1;if(one)$r.find('.repeat-count').val(1);$r.find('.repeat-count').prop('readonly',one);updateAmountMode($r)}
function renumber(){$('#scheduleRows .schedule-row').each(function(i){$(this).find('.row-number').text(i+1);$(this).find('input,select').each(function(){this.name=this.name.replace(/PlanScheduleRow\]\[\d+\]/,'PlanScheduleRow]['+i+']')})});rowIndex=$('#scheduleRows .schedule-row').length}
function calculate(){var total=num($('#PlanTotalAmount').val()),used=0;$('#scheduleRows .schedule-row').each(function(){var $r=$(this),v=num($r.find('.amount-value').val()),c=Math.max(1,parseInt($r.find('.repeat-count').val(),10)||1),unit=$r.find('.amount-mode').val()==='percentage'?total*v/100:v,rowTotal=Math.round(unit*100)/100*c;used+=rowTotal;$r.find('.row-total').text(money(rowTotal))});used=Math.round(used*100)/100;var diff=Math.round((total-used)*100)/100,match=total>0&&Math.abs(diff)<=.01;$('#summaryPlanTotal').text(money(total));$('#summaryScheduleTotal').text(money(used));$('#summaryDifference').text(money(diff));$('#summaryStatus').toggleClass('is-match',match).toggleClass('is-short',!match).text(match?'Payment plan total is complete':(diff>0?'Remaining amount: '+money(diff):'Plan exceeds total by: '+money(Math.abs(diff))));$('#savePlanButton').prop('disabled',!match)}
$('#addScheduleRow').on('click',function(){var i=rowIndex++,h='<tr class="schedule-row"><td class="row-number"></td><td><select name="data[PlanScheduleRow]['+i+'][payment_type]" class="form-control payment-type">'+options()+'</select></td><td><input name="data[PlanScheduleRow]['+i+'][title]" class="form-control row-title" required></td><td><select name="data[PlanScheduleRow]['+i+'][amount_mode]" class="form-control amount-mode"><option value="fixed">Amount</option><option value="percentage">Percentage</option></select></td><td><div class="input-group amount-value-wrap"><input type="number" min="0.01" step="0.01" name="data[PlanScheduleRow]['+i+'][amount_value]" class="form-control amount-value" placeholder="0.00" required><span class="input-group-addon amount-unit">Rs</span></div></td><td><input type="number" min="1" step="1" name="data[PlanScheduleRow]['+i+'][repeat_count]" value="1" class="form-control repeat-count" required></td><td><input type="number" min="0" step="1" name="data[PlanScheduleRow]['+i+'][interval_months]" value="1" class="form-control interval-months" required></td><td><strong class="row-total">Rs 0</strong></td><td><button type="button" class="btn btn-danger remove-row"><span class="fa fa-trash"></span></button></td></tr>';$('#scheduleRows').append(h);var $r=$('#scheduleRows .schedule-row:last');$r.find('.payment-type').val('custom');updateType($r,true);renumber();calculate()});
$('#scheduleRows').on('change','.payment-type',function(){updateType($(this).closest('tr'),true);calculate()}).on('change','.amount-mode',function(){updateAmountMode($(this).closest('tr'));calculate()}).on('input change','input,select',calculate).on('click','.remove-row',function(){$(this).closest('tr').remove();renumber();calculate()});$('#PlanTotalAmount').on('input change',calculate);$('#scheduleRows .schedule-row').each(function(){updateType($(this),false)});renumber();calculate();
})(jQuery);
</script>
